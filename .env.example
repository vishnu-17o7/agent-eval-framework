# Agent Evaluation Framework — Environment Variables
# Copy this file to .env and fill in your values

# OpenRouter API key (optional — mock mode runs without it)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Custom database path (defaults to ~/.agent_eval.db)
# AGENT_EVAL_DB=C:\Users\banur\.agent_eval.db

# Custom dataset directory (defaults to agent_eval/datasets/scenarios/)
# AGENT_EVAL_DATASET_DIR=C:\Users\banur\agent_eval_datasets
